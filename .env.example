# Copie para .env antes de rodar "docker compose up".
#   cp .env.example .env

# --- Obrigatorio ---
# Chave HMAC-SHA256 do JWT: no minimo 32 bytes. Gere a sua com:
#   openssl rand -base64 48
SITPA_JWT_SEGREDO=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-48

# --- Banco ---
POSTGRES_DB=sitpa
POSTGRES_USER=sitpa
POSTGRES_PASSWORD=sitpa
POSTGRES_PORTA=5432

# --- Aplicacao ---
SITPA_PORTA_BACKEND=8090
SITPA_PORTA_FRONTEND=80
SITPA_JWT_VALIDADE_MINUTOS=480

# Senhas dos usuarios criados na primeira subida. Troque-as antes de qualquer uso real.
SITPA_SENHA_ADMIN=admin123
SITPA_SENHA_TRIAGEM=triagem123

# Deixe true para criar o protocolo de demonstracao (Manchester) quando o banco esta vazio.
# Coloque false ao implantar em uma unidade que vai cadastrar o proprio protocolo.
SITPA_SEED_INICIAL=true

# Aceita curinga (http://localhost:*). Em producao, prefira listar as origens exatas.
SITPA_CORS_ORIGENS=http://localhost,http://localhost:*
